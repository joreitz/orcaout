! UKS SP PBE0 D4 ma-DEF2-TZVP RIJCOSX CPCM(DCM) TIGHTSCF
! SLOWCONV DEFGRID3 NOTRAH SOSCF KDIIS

%tddft
	nroots 130
	DoNTO True
	NTOThresh 1e-4
end


%scf
  MaxIter 600
end

%basis
  AuxJ "DEF2/JK"
end

%cpcm
  surfacetype    vdw_gaussian
end

%output
  # shorten output to get smaller .out files
  Print[ P_Internal ]          0  # internal coordinates
  Print[ P_OrbEn ]             0  # orbital energies
  Print[ P_Basis ]             0  # basis set information
  Print[ P_Mayer ]             0  # Mayer population analysis
  Print[ P_Loewdin ]           0  # Loewdin population analysis
  # Mulliken population analysis
  Print[ P_AtCharges_M ]       1  # atomic charges
  Print[ P_OrbCharges_M ]      0  # orbital charges
  Print[ P_FragCharges_M ]     0  # fragment charges
  Print[ P_BondOrder_M ]       1  # bond orders
  Print[ P_FragBondOrder_M ]   0  # fragment b.o.
  Print[ P_ReducedOrbPop_M ]   0  # reduced orb. Charges
  Print[ P_AtPopMO_M ]         0  # atomic charges in each MO
  Print[ P_OrbPopMO_M ]        0  # orbital pop for each MO
  Print[ P_ReducedOrbPopMO_M ] 0  # reduced orbital pop for each MO
  Print[ P_FragPopMO_M ]       0  # fragment pop for each MO
end

%maxcore 6904

%pal nprocs 28 end  # num_cpus = 28

